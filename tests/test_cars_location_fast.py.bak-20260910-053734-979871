import ast,json,shutil,subprocess,unittest
from pathlib import Path
from types import SimpleNamespace

class FastLocationTests(unittest.TestCase):
    def function(self,name):
        tree=ast.parse((Path(__file__).resolve().parents[1]/'scraper_carro/discovercars.py').read_text())
        fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name==name)
        ns={};exec(compile(ast.Module(body=[fn],type_ignores=[]),'location','exec'),ns)
        return ns[name]
    def test_native_keys_replace_without_control_leak(self):
        keys=SimpleNamespace(CONTROL='\ue009',NULL='\ue000',BACKSPACE='\ue003')
        state={'value':'Outro aeroporto','control':False,'selected':False,'calls':0}
        def send(sequence):
            state['calls']+=1
            for char in sequence:
                if char==keys.CONTROL:state['control']=True
                elif char==keys.NULL:state['control']=False
                elif char=='a' and state['control']:state['selected']=True
                elif char==keys.BACKSPACE:
                    state['value']='' if state['selected'] else state['value'][:-1]
                    state['selected']=False
                else:
                    self.assertFalse(state['control'],'Control deve ser solto antes de digitar o destino')
                    state['value']+=char
        self.function('preencher_local_inicial')(SimpleNamespace(send_keys=send),'Florianópolis Airport (FLN)',keys)
        self.assertEqual(state['value'],'Florianópolis Airport (FLN)')
        self.assertFalse(state['control']);self.assertEqual(state['calls'],1)
