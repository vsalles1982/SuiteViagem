async function refreshHistory(){history=await api('/api/history');renderHistory();}
function money(value){return new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(value/100);}
function safeLink(value){try{const u=new URL(value);if(u.protocol==='https:')return u.href;}catch{}return null;}
async function openQuery(id,provided=null,preview=false){try{const q=provided||await api('/api/query/'+encodeURIComponent(id));currentQuery=q;$('results-panel').hidden=false;$('search-panel').hidden=true;$('results-tab').classList.add('selected');$('search-tab').classList.remove('selected');$('query-title').textContent=description(q);$('result-count').textContent=`(${q.results.length})`;$('query-meta').textContent=`${names[q.module]} · Coletado em ${new Date(q.created_at).toLocaleString('pt-BR')} · ${statuses[q.status]||q.status}`;$('coverage-note').textContent=(q.coverage.status==='complete_for_scope'?'Datas amostradas consultadas. ':'Cobertura parcial ou limitada. ')+q.coverage.scope;$('download').hidden=preview;$('download').href='/api/query/'+id+'/download';$('cards').replaceChildren();if(!q.results.length)$('cards').append(node('p',preview?'Conferindo preços atualizados…':'Esta consulta não retornou resultados. Confira os avisos abaixo.','muted'));for(const item of q.results){const card=node('article',undefined,'offer'),body=node('div');body.append(node('h3',item.title));const details=item.details||{};const address=item.location?.address||details.supplier||details.organizer; if(address)body.append(node('p',address));if(item.period)body.append(node('p',`${item.period.start||'—'}${item.period.end?' → '+item.period.end:''}`));if(details.stay_text)body.append(node('p',details.stay_text));if(details.details_status)body.append(node('p',details.details_status));if(details.room)body.append(node('p',details.room));const url=safeLink(item.source_url);if(url){const a=node('a','Abrir no fornecedor ↗');a.href=url;a.target='_blank';a.rel='noopener noreferrer';body.append(a);}const price=node('div');if(item.price){const p=item.price;price.append(node('div',money(p.total_minor??p.amount_minor),'price'));price.append(node('p',p.total_minor!==null?'Total com taxas exibidas':q.module==='events'?'Preço do lote':q.module==='cars'?'Total anunciado':'Preço anunciado'));if(p.optional_coverage_included!==null)price.append(node('p',p.optional_coverage_included?'Cobertura adicional incluída':'Cobertura adicional excluída'));}else price.append(node('p','Preço não informado'));card.append(body,price);if(item.warnings?.length){const d=node('details');d.append(node('summary','Condições e observações'));for(const warning of item.warnings)d.append(node('p',warning));card.append(d);}$('cards').append(card);}for(const error of q.errors)$('cards').append(node('p',error.message,'notice'));for(const w of q.warnings)$('cards').append(node('p',w,'muted'));if(!preview)$('results-panel').scrollIntoView({behavior:'smooth',block:'start'});}catch(e){message(e.message);}}
async function poll(){try{const state=await api('/api/state');token=state.token;const job=state.job;lastJob=job;const active=job&&['running','cancelling'].includes(job.status);$('submit').disabled=!!active;$('progress-panel').hidden=!job;if(job){$('progress-title').textContent=(active?'Consultando ':job.status==='succeeded'?'Busca concluída · ':'Busca encerrada · ')+names[job.module];$('elapsed').textContent=`${Math.floor(job.elapsed/60)}min ${Math.floor(job.elapsed%60)}s`;$('phase').textContent=job.logs.at(-1)||'Preparando consulta…';$('logs').textContent=job.logs.join('\n');$('cancel').hidden=!active;$('cancel').disabled=job.status==='cancelling';if(active&&module===job.module&&job.preview&&previewSeen!==job.id+':'+job.preview_version){previewSeen=job.id+':'+job.preview_version;await openQuery(job.query_id,job.preview,true);$('coverage-note').textContent='Menores preços encontrados até agora. Carregando mais ofertas… Ao mudar de módulo, a busca será encerrada e o primeiro lote conferido será preservado no histórico.';}if(!active&&loadedJob!==job.id){loadedJob=job.id;await refreshHistory();if(job.query_id&&module===job.module)await openQuery(job.query_id);}}}catch(e){message('Conexão com o servidor local interrompida. Confira o terminal.');}finally{setTimeout(poll,1500);}}
document.querySelectorAll('[data-nav]').forEach(b=>b.onclick=()=>selectModule(b.dataset.nav));$('search-form').oninput=updateSummary;$('search-form').onsubmit=async e=>{e.preventDefault();message('');try{await api('/api/search',formData());$('submit').disabled=true;$('results-panel').hidden=true;}catch(e){message(e.message);}};$('cancel').onclick=async()=>{try{await api('/api/cancel',{});}catch(e){message(e.message);}};$('history-filter').onchange=renderHistory;$('all-history').onclick=()=>selectModule('history');$('search-tab').onclick=()=>selectModule(module);$('results-tab').onclick=()=>{if(lastJob?.module===module&&lastJob.status==='running'&&lastJob.preview)openQuery(lastJob.query_id,lastJob.preview,true);else if(currentQuery)openQuery(currentQuery.query_id);else message('Faça uma busca ou abra uma consulta do histórico.');};selectModule('hotels');refreshHistory().catch(e=>message(e.message));poll();
