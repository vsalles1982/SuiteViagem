else{field(next==='cars'?'LOCAL ESPECÍFICO DE RETIRADA':'DESTINO','destination',d.destination||({hotels:'Petrópolis',cars:'Ibiza Airport',events:'São Paulo'}[next]),'text',true);field(next==='hotels'?'CHECK-IN':next==='cars'?'RETIRADA':'DATA INICIAL','start',d.start||dateOffset(5),'date');field(next==='hotels'?'CHECK-OUT':next==='cars'?'DEVOLUÇÃO':'DATA FINAL','end',d.end||dateOffset(6),'date');if(next==='hotels'){const label=node('label','TIPO DE CONSULTA','wide'),select=node('select');select.name='details_mode';for(const [value,title] of [['prices','Preços e taxas dos cartões'],['full','Consulta completa com endereços (mais demorada)']]){const o=node('option',title);o.value=value;select.append(o);}select.value=d.details_mode||'prices';label.append(select);$('fields').append(label);}if(next!=='hotels')field('QUANTIDADE MÁXIMA','limit',d.limit||5,'number',true,1,next==='events'?50:100);$('conditions').textContent={hotels:'2 adultos · 1 quarto · Navegador oculto. A busca de preços dispensa visitas individuais; endereços completos ficam para a consulta completa. Excel preservado.',cars:'11h → 11h · Residência Brasil · Idade 35 · Devolução no mesmo local. O navegador abre durante a busca.',events:'Eventos com início no período. O limite não representa todos os eventos da cidade.'}[next];}
