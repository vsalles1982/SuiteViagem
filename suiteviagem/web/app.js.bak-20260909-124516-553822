function formData(){return {...Object.fromEntries(new FormData($('search-form'))),module,roundtrip:$('roundtrip')?.value==='yes'};}
function selectModule(next){if(next!==module&&module==='hotels'&&lastJob?.module==='hotels'&&lastJob.status==='running'){frozenHotelPreview=lastJob.first_preview;api('/api/cancel',{}).catch(e=>message(e.message));}if(next!==module)currentQuery=null;if(module!=='history')drafts[module]=formData();module=next;document.body.dataset.module=next;document.querySelectorAll('[data-nav]').forEach(b=>{b.removeAttribute('aria-current');if(b.dataset.nav===next)b.setAttribute('aria-current','page');});$('title').textContent=names[next];$('source').textContent=sources[next];$('history-panel').hidden=next!=='history';$('search-panel').hidden=next==='history';$('results-panel').hidden=true;$('search-tab').hidden=next==='history';$('results-tab').hidden=next==='history';$('recent-panel').hidden=next==='history';$('search-tab').classList.add('selected');$('results-tab').classList.remove('selected');$('fields').replaceChildren();message('');if(next==='history'){renderHistory();return;}
