const $=id=>document.getElementById(id), names={flights:'Voos',hotels:'Hospedagem',cars:'Carros',events:'Eventos',history:'Histórico'}, sources={flights:'GOOGLE FLIGHTS',hotels:'BOOKING',cars:'DISCOVERCARS',events:'SHOTGUN',history:'SUA MEMÓRIA DE VIAGEM'};
