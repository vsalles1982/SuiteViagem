function updateSummary(){const d=formData();$('summary-destination').textContent=module==='flights'?`${d.origin||'—'} → ${d.destination||'—'}`:d.destination||'Seu destino';$('summary-dates').textContent=module==='flights'?`Horizonte: ${d.horizon} dias · Intervalo: ${d.step}`:`${d.start||'—'} → ${d.end||'—'}`;$('summary-conditions').textContent=$('conditions').textContent;}
function description(q){const r=q.requested||{};return r.origin?`${r.origin} → ${r.destination}`:r.destination||r.city||r.location||names[q.module];}
function renderRows(target,rows){target.replaceChildren();if(!rows.length){target.append(node('p','Nenhuma consulta salva neste filtro.','muted'));return;}for(const q of rows){const row=node('div',undefined,'history-row'),button=node('button',description(q));button.append(node('small',`${names[q.module]} · ${new Date(q.created_at).toLocaleString('pt-BR')} · ${q.count} resultado(s)`));button.onclick=()=>openQuery(q.query_id);row.append(button,node('span',statuses[q.status]||q.status,'tag'));target.append(row);}}
